{
  "format": "dataforge.queue.table",
  "version": 1,
  "facts": {
    "table:jobs": "STRICT",
    "table:jobs/column:argv": "argv TEXT NOT NULL",
    "table:jobs/column:boot_id": "boot_id TEXT",
    "table:jobs/column:cancel_requested_at": "cancel_requested_at REAL",
    "table:jobs/column:cwd": "cwd TEXT NOT NULL",
    "table:jobs/column:dedup_key": "dedup_key TEXT",
    "table:jobs/column:ended_at": "ended_at REAL",
    "table:jobs/column:exit_code": "exit_code INTEGER",
    "table:jobs/column:id": "id INTEGER PRIMARY KEY AUTOINCREMENT",
    "table:jobs/column:labels": "labels TEXT NOT NULL",
    "table:jobs/column:log": "log TEXT NOT NULL",
    "table:jobs/column:memory_mib": "memory_mib INTEGER NOT NULL",
    "table:jobs/column:pid": "pid INTEGER",
    "table:jobs/column:queue": "queue TEXT NOT NULL",
    "table:jobs/column:queued_at": "queued_at REAL NOT NULL",
    "table:jobs/column:started_at": "started_at REAL",
    "table:jobs/column:starttime": "starttime INTEGER",
    "table:jobs/column:state": "state TEXT NOT NULL CHECK (state IN ('queued', 'running', 'done', 'failed', 'canceled'))",
    "table:jobs/index:jobs_live_key": "CREATE UNIQUE INDEX jobs_live_key ON jobs (dedup_key) WHERE state IN ('queued', 'running')",
    "table:jobs/index:jobs_state": "CREATE INDEX jobs_state ON jobs (state, queue, id)"
  }
}
