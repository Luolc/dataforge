    "field:cause": "Literal['429', 'quota'] | None",
    "field:delay": "float | None",
    "field:lifted": "dataforge.gateway.pause.Lifted | None, optional",
    "field:paused_s": "float",
    "field:refusal": "str | None",
    "field:refusals": "int",
    "field:since": "float | None",
    "field:stopped": "str | None",
    "field:until": "float"
  }
}
