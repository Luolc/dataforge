{
  "format": "dataforge.runs.store",
  "version": 1000,
  "facts": {
    "table:attempt": "STRICT",
    "table:attempt/column:cost_usd": "cost_usd REAL",
    "table:attempt/column:created_at": "created_at TEXT NOT NULL",
    "table:attempt/column:ended_at": "ended_at TEXT",
    "table:attempt/column:extra": "extra TEXT NOT NULL DEFAULT '{}'",
    "table:attempt/column:holder_boot_id": "holder_boot_id TEXT",
    "table:attempt/column:holder_pid": "holder_pid INTEGER",
    "table:attempt/column:holder_starttime": "holder_starttime INTEGER",
    "table:attempt/column:id": "id TEXT PRIMARY KEY",
    "table:attempt/column:item": "item TEXT NOT NULL",
    "table:attempt/column:job_db": "job_db TEXT",
    "table:attempt/column:job_id": "job_id INTEGER",
    "table:attempt/column:machine_status": "machine_status TEXT",
    "table:attempt/column:outcome": "outcome TEXT",
    "table:attempt/column:progress_at": "progress_at TEXT",
    "table:attempt/column:reason": "reason TEXT",
    "table:attempt/column:record": "record TEXT",
    "table:attempt/column:resumable": "resumable INTEGER",
    "table:attempt/column:resume_checked_at": "resume_checked_at TEXT",
    "table:attempt/column:resume_problem": "resume_problem TEXT",
    "table:attempt/column:root": "root TEXT NOT NULL",
    "table:attempt/column:settled_at": "settled_at TEXT",
    "table:attempt/column:state": "state TEXT NOT NULL CHECK (state IN ('running', 'interrupted', 'ended'))",
    "table:attempt/column:stopped_by": "stopped_by TEXT CHECK (stopped_by IN ('person', 'lost'))",
    "table:attempt/index:attempt_item": "CREATE INDEX attempt_item ON attempt (item, created_at)",
    "table:attempt/index:one_running_per_item": "CREATE UNIQUE INDEX one_running_per_item ON attempt (item) WHERE state = 'running'",
    "table:event": "STRICT",
    "table:event/column:at": "at TEXT NOT NULL",
    "table:event/column:attempt_id": "attempt_id TEXT NOT NULL",
    "table:event/column:by": "by TEXT NOT NULL",
    "table:event/column:detail": "detail TEXT NOT NULL",
    "table:event/column:from_state": "from_state TEXT",
    "table:event/column:to_state": "to_state TEXT NOT NULL",
    "table:event/index:event_attempt": "CREATE INDEX event_attempt ON event (attempt_id)",
    "table:meta": "STRICT",
    "table:meta/column:name": "name TEXT PRIMARY KEY",
    "table:meta/column:value": "value INTEGER NOT NULL"
  }
}
