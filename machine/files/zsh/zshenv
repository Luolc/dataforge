# Installed by the dataforge data machine setup (machine/files/zsh/zshenv);
# edit the source, not this file.
# uv, Claude Code and other per-user tools live in ~/.local/bin. Every zsh
# reads .zshenv, so non-interactive shells (ssh commands, scripts) find them too.
# The account gateway's `claude` shim comes first, ahead of the real Claude
# Code in ~/.local/bin (docs/design.md). Until the gateway client is installed
# its directory does not exist, and the entry does nothing.
export PATH="$HOME/.local/libexec/redcoast-client/current:$HOME/.local/bin:$PATH"
# Machine-specific private settings (environment variables that do not belong
# in this repo) go in ~/.config/dataforge/zshenv.local, sourced here when it
# is readable. The setup never creates or overwrites that file.
if [[ -r $HOME/.config/dataforge/zshenv.local ]]; then
  source "$HOME/.config/dataforge/zshenv.local"
fi
